# Inquiry endpoint (api/inquiry.ts) — Phase 5
#
# Copy this file to .env.local for local development. In production, set
# these as Environment Variables on the acc-solutions-website Vercel project.
# Never commit real values.

# Transactional email provider used to deliver inquiries to ACC.
# Sign up at https://resend.com, verify a sending domain (e.g. accsolutions.dev
# or a subdomain of it), and create an API key.
RESEND_API_KEY=

# Verified "from" address on the Resend domain, e.g. inquiries@accsolutions.dev
INQUIRY_FROM_EMAIL=

# Where inquiries should be delivered, e.g. nickboyce.tech@icloud.com
INQUIRY_TO_EMAIL=

# CORS allow-list for the /api/inquiry endpoint. Defaults to
# https://accsolutions.dev if unset. Only needs to change if the frontend is
# ever served from a different origin than the API.
ALLOWED_ORIGIN=

# Optional: only needed if the frontend is deployed separately from this
# Vercel project. Client-exposed (Astro requires the PUBLIC_ prefix to ship
# it to the browser). Defaults to the relative "/api/inquiry" when unset.
PUBLIC_INQUIRY_API_URL=
