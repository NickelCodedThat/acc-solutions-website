---
import { navigation } from "@data/site";

const pathname = Astro.url.pathname;

function isCurrentNavigationItem(label: string) {
  if (label === "Solutions") {
    return pathname === "/solutions";
  }

  if (label === "Work") {
    return pathname === "/work" || pathname.startsWith("/work/");
  }

  return false;
}
---

<header class="site-header">
  <nav class="nav container" aria-label="Main navigation">
    <a class="logo" href="/" aria-label="ACC Solutions home">
      <span class="logo-mark">A</span>
      <span class="logo-text">ACC Solutions</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <span class="sr-only">Open navigation menu</span>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-panel" id="nav-menu">
      <ul class="nav-menu">
        {navigation.map((item) => {
          const isCurrent = isCurrentNavigationItem(item.label);

          return (
            <li>
              <a class:list={{ "is-current": isCurrent }} href={item.href} aria-current={isCurrent ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
      <a class="nav-cta" href="/#contact">Talk With ACC</a>
    </div>
  </nav>
</header>
