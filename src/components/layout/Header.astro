---
import { navigation } from "@data/site";
---

<header class="site-header">
  <nav class="nav container" aria-label="Main navigation">
    <a class="logo" href="/" aria-label="ACC Solutions home">
      <span class="logo-mark">A</span>
      <span class="logo-text">ACC Solutions</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
      <span class="sr-only">Open navigation menu</span>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-panel" id="nav-menu">
      <ul class="nav-menu">
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a class="nav-cta" href="#contact">Talk With ACC</a>
    </div>
  </nav>
</header>
