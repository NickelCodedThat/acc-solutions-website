---
import "@styles/cinematic-entry.css";
---

<section class="cinematic-entry" data-cinematic-entry aria-label="ACC Solutions introduction">
  <div class="cinematic-entry__panel cinematic-entry__panel--left" aria-hidden="true"></div>
  <div class="cinematic-entry__panel cinematic-entry__panel--right" aria-hidden="true"></div>

  <div class="cinematic-entry__field" aria-hidden="true">
    <div class="cinematic-entry__grid"></div>
    <span class="cinematic-entry__axis cinematic-entry__axis--horizontal"></span>
    <span class="cinematic-entry__axis cinematic-entry__axis--vertical"></span>
    <span class="cinematic-entry__datum cinematic-entry__datum--one"></span>
    <span class="cinematic-entry__datum cinematic-entry__datum--two"></span>
    <span class="cinematic-entry__datum cinematic-entry__datum--three"></span>
    <span class="cinematic-entry__datum cinematic-entry__datum--four"></span>
  </div>

  <div class="cinematic-entry__frame" aria-hidden="true">
    <span class="cinematic-entry__corner cinematic-entry__corner--top-left"></span>
    <span class="cinematic-entry__corner cinematic-entry__corner--top-right"></span>
    <span class="cinematic-entry__corner cinematic-entry__corner--bottom-left"></span>
    <span class="cinematic-entry__corner cinematic-entry__corner--bottom-right"></span>
  </div>

  <div class="cinematic-entry__copy">
    <p class="cinematic-entry__brand">ACC SOLUTIONS</p>
    <p class="cinematic-entry__statement">WE BUILD THE DIGITAL SYSTEMS BUSINESSES OPERATE ON.</p>
  </div>

  <button class="cinematic-entry__skip" type="button" data-entry-skip>Skip intro</button>
</section>

<script src="../../scripts/cinematic-entry.ts"></script>
