---
import ProjectFrame from "@components/ui/ProjectFrame.astro";
---

<div class="hero-proof reveal" data-hero-preview>
  <div class="hero-proof-header">
    <div>
      <span class="status-dot" aria-hidden="true"></span>
      <span>Current development proof</span>
    </div>
    <span>Crew Command / CCV2</span>
  </div>

  <ProjectFrame
    src="/images/proof/crew-command-shifts.png"
    alt="Current Crew Command scheduling screen with property assignment, shift controls, and operational records"
    width={1098}
    height={900}
    label="Owner operations / scheduling"
    loading="eager"
    priority="high"
    class="hero-project-frame"
  />

  <div class="hero-proof-foot">
    <p>Built around the operation</p>
    <ul aria-label="Crew Command capabilities shown in the current build">
      <li>Scheduling</li>
      <li>Time</li>
      <li>Properties</li>
      <li>Work records</li>
    </ul>
  </div>
</div>
