---
import { site } from "@data/site";
---

<section class="section contact-section" id="contact">
  <div class="container contact-grid">
    <div class="contact-copy reveal">
      <h2>Tell us where the business is getting stuck.</h2>
      <p>
        You do not need to diagnose the technology. Explain the goal, the bottleneck, the
        current process, and what a better outcome would look like. ACC will help map the right solution.
      </p>
      <div class="contact-methods" aria-label="Direct contact options">
        <div class="contact-method">
          <span>Email</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
        <div class="contact-method">
          <span>Phone</span>
          <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </div>
        <div class="contact-method">
          <span>Domain</span>
          <a href={site.url}>{site.domain}</a>
        </div>
      </div>
    </div>

    <form class="contact-form reveal" id="quote-form" aria-label="Business improvement inquiry form" novalidate>
      <div class="form-header">
        <span>Business Improvement Inquiry</span>
        <p>Required fields are marked with *</p>
      </div>

      <div class="field two-column">
        <label for="name">Name *</label>
        <input id="name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
      </div>

      <div class="field two-column">
        <label for="email">Email *</label>
        <input id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="business">Business Name *</label>
        <input id="business" name="business" type="text" placeholder="Your business" autocomplete="organization" required />
      </div>

      <div class="field">
        <label for="service">Where is the friction? *</label>
        <select id="service" name="service" required>
          <option value="">Select the closest fit</option>
          <option value="Reduce manual work">Reduce manual work</option>
          <option value="Organize operations">Organize operations</option>
          <option value="Improve management visibility">Improve management visibility</option>
          <option value="Improve customer experience">Improve customer experience</option>
          <option value="Strengthen digital presence">Strengthen digital presence</option>
          <option value="Connect existing tools">Connect existing tools</option>
          <option value="Not sure yet">Not sure yet</option>
        </select>
      </div>

      <div class="field">
        <label for="budget">Estimated Budget</label>
        <select id="budget" name="budget">
          <option value="Not selected">Select a range</option>
          <option value="Under $1,000">Under $1,000</option>
          <option value="$1,000 - $2,500">$1,000 - $2,500</option>
          <option value="$2,500 - $5,000">$2,500 - $5,000</option>
          <option value="$5,000+">$5,000+</option>
          <option value="Need guidance">Need guidance</option>
        </select>
      </div>

      <div class="field">
        <label for="timeline">Ideal Timeline</label>
        <select id="timeline" name="timeline">
          <option value="Not selected">Select a timeline</option>
          <option value="ASAP">ASAP</option>
          <option value="2-4 weeks">2-4 weeks</option>
          <option value="1-2 months">1-2 months</option>
          <option value="Flexible">Flexible</option>
        </select>
      </div>

      <div class="field">
        <label for="message">What is happening in the business? *</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          placeholder="Tell us what your business does, what is slowing the team down, where information gets lost, or what outcome you need the business to reach."
          required
        ></textarea>
      </div>

      <div class="field hp-field" aria-hidden="true">
        <label for="website">Website</label>
        <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>

      <button class="btn btn-primary" type="submit">
        <span data-btn-label>Send Inquiry</span>
        <span aria-hidden="true">+</span>
      </button>

      <p class="form-note">ACC replies directly to the email address above, usually within one business day.</p>
    </form>
  </div>
</section>
