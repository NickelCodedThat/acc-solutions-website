---
import SiteLayout from "@layouts/SiteLayout.astro";
import HeroPreview from "@components/sections/HeroPreview.astro";
import WorkCases from "@components/sections/WorkCases.astro";
import ContactSection from "@components/sections/ContactSection.astro";
import SectionIntro from "@components/ui/SectionIntro.astro";
import { site } from "@data/site";

const problems = [
  ["01", "Leads fall through the cracks.", "Inquiries arrive through forms, calls, inboxes, and messages without one clear path for follow-up."],
  ["02", "Teams operate from texts and spreadsheets.", "Information lives in too many places, so people repeat work or chase answers manually."],
  ["03", "Management cannot see the operation clearly.", "Jobs, customers, properties, tasks, and status updates become hard to track as the company grows."],
  ["04", "The website is disconnected from the business.", "A public site may look decent but still fail to support intake, booking, CRM, analytics, or operations."],
  ["05", "Processes that once worked stop scaling.", "What worked for a small team can break when more employees, customers, locations, or requests are involved."],
  ["06", "Technology exists, but it is not connected.", "The tools are there, but the business still lacks a system that makes the operation easier to run."],
] as const;

const diagnostics = [
  "Operational bottlenecks",
  "Customer experience",
  "Manual repetition",
  "Management visibility",
  "Growth constraints",
  "System leverage",
] as const;

const capabilities = [
  {
    index: "01",
    title: "Digital Presence",
    copy: "Premium websites and digital infrastructure that make the business easier to trust, contact, measure, and grow.",
    items: ["Premium business websites", "Website redesign", "Conversion-focused experiences", "SEO infrastructure", "Analytics, hosting, and maintenance"],
  },
  {
    index: "02",
    title: "Business Systems",
    copy: "Custom applications, portals, dashboards, and software designed around internal workflows and visibility.",
    items: ["Full-stack web applications", "Internal operational software", "Dashboards and reporting views", "Client and employee portals", "Database-backed applications"],
  },
  {
    index: "03",
    title: "Automation & Integration",
    copy: "Connected workflows that reduce manual handoffs and keep information moving between the tools a business uses.",
    items: ["Workflow automation", "Lead-routing systems", "Customer-intake automation", "Email and follow-up flows", "Tool integrations and data movement"],
  },
  {
    index: "04",
    title: "Growth & Optimization",
    copy: "Ongoing improvement for businesses that need their digital systems to evolve as operations become more complex.",
    items: ["Digital process consulting", "Performance optimization", "Conversion improvements", "Business-system audits", "Ongoing systems improvement"],
  },
] as const;

const crewCommandStory = [
  ["Problem", "Property and field-service operations often rely on scattered information, texts, paper processes, spreadsheets, and disconnected tools."],
  ["ACC Solution", "CrewCommand demonstrates a centralized platform built around properties, job sites, users, workflows, and management visibility."],
  ["Business Purpose", "Give management one organized operating environment instead of forcing teams to piece information together across disconnected systems."],
] as const;

const crewCommandScreens = [
  {
    src: "/images/crewcommand/04-dashboard-desktop.png",
    alt: "CrewCommand command center dashboard desktop screen",
    width: 1440,
    height: 900,
    caption: "Command Center Dashboard",
  },
  {
    src: "/images/crewcommand/05-properties-desktop.png",
    alt: "CrewCommand property management desktop screen",
    width: 1440,
    height: 900,
    caption: "Property Management",
  },
  {
    src: "/images/crewcommand/08-dashboard-mobile.png",
    alt: "CrewCommand mobile command center screen",
    width: 390,
    height: 844,
    caption: "Mobile Command Center",
  },
] as const;

const presenceLinks = ["Lead capture", "Scheduling", "CRM", "Analytics", "Automation", "Internal workflows"] as const;
const partnershipItems = ["Maintenance", "New workflows", "Automation", "Integrations", "Optimization", "Analytics", "Additional systems"] as const;

const processSteps = [
  ["01", "Diagnose", "Understand the operation, goals, bottlenecks, and opportunity."],
  ["02", "Map", "Determine what needs to change and where technology creates leverage."],
  ["03", "Design", "Design the experience, workflow, architecture, or system."],
  ["04", "Build", "Develop and integrate the solution with clean, maintainable implementation."],
  ["05", "Launch", "Test, deploy, prepare handoff, and transition the system into use."],
  ["06", "Improve", "Measure, maintain, automate further, and evolve as the business grows."],
] as const;
---

<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-atmosphere" aria-hidden="true">
      <span class="hero-plane hero-plane-one"></span>
      <span class="hero-plane hero-plane-two"></span>
      <span class="hero-scanline"></span>
    </div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow reveal">Digital product & systems studio</p>
        <h1 id="hero-title" class="reveal">We Build What Moves Your Business Forward.</h1>
        <p class="hero-text reveal">
          ACC Solutions studies how your business operates, identifies where technology can
          create leverage, then designs and builds the websites, software, automation,
          integrations, and digital systems needed to make it happen.
        </p>
        <p class="hero-statement reveal">{site.statement}</p>
        <div class="hero-actions reveal" aria-label="Primary actions">
          <a class="btn btn-primary" href="#contact">
            <span>Talk With ACC</span>
            <span aria-hidden="true">+</span>
          </a>
          <a class="btn btn-secondary" href="#solutions">
            <span>See What We Build</span>
          </a>
        </div>
      </div>

      <HeroPreview />
    </div>
  </section>

  <section class="section problems-section" id="problems">
    <div class="container">
      <SectionIntro
        eyebrow="Business friction"
        title="Technology should remove friction, not create more of it."
        copy="ACC is built for companies that have momentum, but can feel the drag of disconnected tools, manual work, scattered information, and customer experiences that no longer match the quality of the business."
      />

      <div class="problem-grid reveal-group">
        {problems.map(([index, title, copy]) => (
          <article class="problem-card reveal">
            <span>{index}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section thinking-section" id="thinking">
    <div class="container thinking-grid">
      <SectionIntro eyebrow="How ACC thinks" title="We do not start with technology. We start with the business." />
      <div class="thinking-panel reveal">
        <p>
          ACC studies the current operation first: what slows the company down, what customers
          experience, where information gets lost, what employees repeatedly do manually, and
          what management cannot easily see.
        </p>
        <p>
          Then we recommend the appropriate system. Sometimes that is a better website.
          Sometimes it is a dashboard, portal, automation, CRM workflow, full-stack
          application, or a combination of connected tools.
        </p>
        <div class="diagnostic-list" aria-label="ACC diagnostic focus areas">
          {diagnostics.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section solutions-section" id="solutions">
    <div class="container">
      <SectionIntro
        eyebrow="Solutions / capabilities"
        title="ACC has a toolbox. The business problem decides which tools matter."
        copy="The goal is not to sell every client the same package. The goal is to put the right technology plan in place and build the solution around the way the company actually works."
      />

      <div class="capability-grid reveal-group">
        {capabilities.map((capability) => (
          <article class="capability-card reveal">
            <div class="capability-index">{capability.index}</div>
            <h3>{capability.title}</h3>
            <p>{capability.copy}</p>
            <ul>
              {capability.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section systems-section" id="systems">
    <div class="container">
      <SectionIntro
        eyebrow="Flagship systems proof"
        title="CrewCommand shows how ACC thinks beyond a marketing website."
        copy="CrewCommand is an active development preview for a custom operations platform. It is presented honestly as systems proof: a demonstration of how ACC can organize real business workflows into a centralized digital environment."
      />

      <article class="system-case reveal">
        <div class="case-copy">
          <div class="software-project-meta">
            <span>Custom Operations Management Platform</span>
            <span>Development Preview</span>
          </div>
          <h3>CrewCommand</h3>
          <div class="case-story">
            {crewCommandStory.map(([label, copy]) => (
              <div>
                <span>{label}</span>
                <p>{copy}</p>
              </div>
            ))}
          </div>
        </div>

        <figure class="system-image">
          <img
            src="/images/crewcommand/contact-sheet.png"
            alt="CrewCommand development preview showing desktop and mobile operations platform screens"
            width="2000"
            height="1930"
          />
        </figure>
      </article>

      <div class="system-gallery reveal-group">
        {crewCommandScreens.map((screen) => (
          <figure class="reveal">
            <img src={screen.src} alt={screen.alt} loading="lazy" width={screen.width} height={screen.height} />
            <figcaption>{screen.caption}</figcaption>
          </figure>
        ))}
      </div>

      <div class="systems-cta reveal">
        <h3>Could ACC build something like this around your company?</h3>
        <p>Tell us where your operation is scattered. ACC can help map the system and determine what should be built next.</p>
        <a class="btn btn-primary" href="#contact">
          <span>Talk Through a System</span>
          <span aria-hidden="true">+</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section presence-section" id="presence">
    <div class="container presence-grid">
      <SectionIntro eyebrow="Digital presence" title="Your website is often the front door to the rest of your business." />
      <div class="presence-copy reveal">
        <p>
          Web development remains a major ACC strength. The difference is that a website is
          treated as part of the larger digital operation, not just a brochure.
        </p>
        <p>
          A properly designed website can connect into lead capture, scheduling, CRM, payments,
          customer communication, analytics, automation, and internal processes.
        </p>
        <div class="presence-links" aria-label="Website system connections">
          {presenceLinks.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section work-section" id="work">
    <div class="container">
      <SectionIntro
        eyebrow="Selected work / case studies"
        title="Real projects, framed around what they help the business do."
        copy="The work below includes active projects, development previews, public websites, and front-end applications. ACC does not invent results. The proof is in the thinking, the build quality, and the system purpose."
      />

      <div class="work-showcase reveal">
        <div class="work-showcase-frame">
          <img
            src="/images/WorkDisplay.png"
            alt="Composite showcase of ACC Solutions website and application work"
            loading="lazy"
            width="1536"
            height="1024"
          />
        </div>
      </div>

      <WorkCases />
    </div>
  </section>

  <section class="section process-section" id="process">
    <div class="container">
      <SectionIntro eyebrow="Process" title="A consulting path from business friction to working system." />

      <div class="process-list reveal-group">
        {processSteps.map(([index, title, copy]) => (
          <article class="process-step reveal">
            <span>{index}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section partnership-section" id="partnership">
    <div class="container partnership-grid">
      <SectionIntro eyebrow="Ongoing partnership" title="Technology is rarely finished because the business keeps moving." />
      <div class="partnership-panel reveal">
        <p>
          ACC can continue supporting improvements, maintenance, new functionality,
          automation, integrations, optimization, analytics, and additional systems as the
          business changes.
        </p>
        <div class="partnership-list">
          {partnershipItems.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section final-cta-section" aria-labelledby="final-cta-title">
    <div class="container">
      <div class="final-cta reveal">
        <p class="eyebrow">Start with the business problem</p>
        <h2 id="final-cta-title">Where is technology holding your business back?</h2>
        <p>
          Tell ACC what you are trying to accomplish, what is taking too much time, what is not
          working, or where the business needs to grow. We will help determine what technology
          should do next.
        </p>
        <a class="btn btn-primary" href="#contact">
          <span>Talk With ACC</span>
          <span aria-hidden="true">+</span>
        </a>
      </div>
    </div>
  </section>

  <ContactSection />
</SiteLayout>
